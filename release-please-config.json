{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "bootstrap-sha": "5d0969bee913794ed0f03ba5b830b494df333af2",
  "release-type": "node",
  "include-component-in-tag": false,
  "include-v-in-tag": true,
  "draft": true,
  "force-tag-creation": true,
  "changelog-path": "CHANGELOG.md",
  "packages": {
    ".": {
      "component": "gblab",
      "release-type": "node",
      "extra-files": [
        {
          "type": "toml",
          "path": "Cargo.toml",
          "jsonpath": "$.workspace.package.version"
        },
        {
          "type": "toml",
          "path": "Cargo.lock",
          "jsonpath": "$.package[?(@.name == 'gblab-core' || @.name == 'gblab-desktop')].version"
        },
        {
          "type": "json",
          "path": "src-tauri/tauri.conf.json",
          "jsonpath": "$.version"
        }
      ]
    }
  }
}
